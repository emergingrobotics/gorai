[Unit]
Description=Gorai container hello-camera-gorai-core
Requires=hello-camera-nats.service
After=hello-camera-nats.service

[Container]
ContainerName=hello-camera-gorai-core
Image=hello-camera-gorai-core.build
Network=hello-camera-network.network
PublishPort=8080:8080
Volume=./hello-camera.json:/etc/gorai/robot.json:ro,Z
AddDevice=/dev/video0:/dev/video0
Environment=GORAI_COMPONENTS=main_camera
Environment=GORAI_SERVICES=dashboard
Environment=LOG_LEVEL=info
Environment=GORAI_ROBOT_NAME=hello-camera
Environment=NATS_URL=nats://nats:4222
HealthCmd=wget -q --spider http://localhost:8080/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target

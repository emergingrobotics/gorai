{
  "version": "3.8",
  "services": {
    "gorai-core": {
      "image": "localhost/hello-camera-core:latest",
      "build": {
        "context": "/workspace",
        "dockerfile": "Containerfile.core"
      },
      "container_name": "hello-camera-gorai-core",
      "depends_on": {
        "nats": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "GORAI_COMPONENTS": "main_camera",
        "GORAI_ROBOT_NAME": "hello-camera",
        "GORAI_SERVICES": "dashboard",
        "LOG_LEVEL": "info",
        "NATS_URL": "nats://nats:4222"
      },
      "volumes": [
        "./hello-camera.json:/etc/gorai/robot.json:ro"
      ],
      "devices": [
        "/dev/video0:/dev/video0"
      ],
      "ports": [
        "8080:8080"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://localhost:8080/health"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      }
    },
    "gorai-hailo": {
      "image": "localhost/hello-camera-hailo:latest",
      "build": {
        "context": "/workspace/services/object-detection",
        "dockerfile": "Containerfile"
      },
      "container_name": "hello-camera-gorai-hailo",
      "depends_on": {
        "gorai-core": {
          "condition": "service_started"
        },
        "nats": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "CONFIDENCE_THRESHOLD": "0.5",
        "GORAI_ROBOT_NAME": "hello-camera",
        "GORAI_SERVICES": "person_detector",
        "MODEL_PATH": "/models/yolox_s_leaky.hef",
        "NATS_URL": "nats://nats:4222"
      },
      "volumes": [
        "./models:/models:ro",
        "./hello-camera.json:/etc/gorai/robot.json:ro"
      ],
      "devices": [
        "/dev/hailo0:/dev/hailo0"
      ],
      "security_opt": [
        "label=disable"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "1G"
          }
        }
      },
      "restart": "unless-stopped"
    },
    "nats": {
      "image": "docker.io/nats:2.10-alpine",
      "container_name": "hello-camera-nats",
      "environment": {
        "GORAI_ROBOT_NAME": "hello-camera",
        "NATS_URL": "nats://nats:4222"
      },
      "ports": [
        "4222:4222",
        "8222:8222"
      ],
      "restart": "always",
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://localhost:8222/healthz"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 3
      }
    }
  },
  "networks": {
    "default": {
      "name": "hello-camera-network"
    }
  }
}
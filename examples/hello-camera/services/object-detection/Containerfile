# Containerfile for Gorai Object Detection Service (Hailo NPU)
#
# This container runs the Python-based object detection service
# using the Hailo-8L NPU for inference.
#
# Build:
#   podman build -t localhost/hello-camera-hailo:latest .
#
# Note: Requires Hailo runtime to be installed on the host and
# /dev/hailo0 device to be passed through.

FROM docker.io/python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Font for annotations
    fonts-dejavu-core \
    # Networking tools
    wget \
    curl \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Install Hailo runtime dependencies (if available)
# Note: On Raspberry Pi, hailo packages come from Hailo's APT repo
# This is a placeholder - actual Hailo SDK installation depends on the system
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     libhailort0 \
#     hailort \
#     && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 gorai && \
    # Add to video group for device access
    usermod -a -G video gorai && \
    chown -R gorai:gorai /app

# Switch to non-root user
USER gorai

# Environment defaults
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=info
ENV NATS_URL=nats://nats:4222
ENV MODEL_PATH=/models/yolox_s_leaky.hef
ENV CONFIDENCE_THRESHOLD=0.5

# Labels
LABEL org.opencontainers.image.title="Gorai Object Detection Service"
LABEL org.opencontainers.image.description="Person detection using Hailo-8L NPU with YOLOx"
LABEL org.opencontainers.image.source="https://github.com/gorai/gorai"

ENTRYPOINT ["python", "main.py"]
CMD ["--config", "/etc/gorai/robot.json"]

{
  "$schema": "https://gorai.dev/schemas/rdl-v2.json",
  "version": "2",

  "robot": {
    "name": "hello-camera",
    "namespace": "hello-camera",
    "description": "A simple camera robot demonstrating V4L2 capture and web dashboard"
  },

  "nats": {
    "url": "nats://localhost:4222"
  },

  "components": [
    {
      "name": "main_camera",
      "type": "camera",
      "model": "v4l2",
      "attributes": {
        "device": "/dev/video0",
        "width": 640,
        "height": 480,
        "frame_rate": 30,
        "jpeg_quality": 80
      }
    }
  ],

  "services": [
    {
      "name": "dashboard",
      "type": "dashboard",
      "model": "web",
      "attributes": {
        "listen": ":8080"
      }
    }
  ],

  "log": {
    "level": "info",
    "format": "json",
    "output": "stdout"
  },

  "dashboard": {
    "enabled": true,
    "listen": ":8080"
  }
}

# Containerfile for gorai
#
# Contains all Gorai Go binaries plus container tooling.
# This is the primary deployment container for Gorai.
#
# Binaries included:
#   - gorai        CLI for robot management (start, stop, status, logs, build)
#   - gorai-robot  Standalone robot runtime for containerized deployment
#
# Container orchestration:
#   Gorai uses Quadlet (systemd-native container management) instead of
#   podman-compose. The gorai CLI generates .container/.network/.volume
#   files that systemd manages directly.
#
# Build:
#   podman build -t ghcr.io/gorai/gorai:latest -f Containerfile.gorai .
#   make container
#
# Usage (build mode - for building container images):
#   podman run --rm -it \
#     --security-opt label=disable \
#     -v /run/podman/podman.sock:/run/podman/podman.sock:rw \
#     -v $(pwd):/workspace:rw \
#     -w /workspace \
#     ghcr.io/gorai/gorai:latest \
#     build --config robot.json
#
# Note: For running containers, use Quadlet directly on the host:
#   gorai start --config robot.json
#   # This generates Quadlet files and uses systemctl to manage services
#
# See: /gorai/specs/gorai-container.md for full specification

# =============================================================================
# Stage 1: Build all Go binaries
# =============================================================================
FROM docker.io/golang:1.22-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Version info (passed from Makefile or defaults)
ARG VERSION=0.1.0
ARG COMMIT=unknown
ARG DATE=unknown

# Build gorai CLI with version info
RUN echo "Building gorai CLI: version=${VERSION} commit=${COMMIT} date=${DATE}" && \
    CGO_ENABLED=0 GOOS=linux go build \
        -ldflags="-s -w \
            -X github.com/gorai/gorai/cmd/gorai/commands.Version=${VERSION} \
            -X github.com/gorai/gorai/cmd/gorai/commands.Commit=${COMMIT} \
            -X github.com/gorai/gorai/cmd/gorai/commands.Date=${DATE}" \
        -o gorai \
        ./cmd/gorai

# Build gorai-robot runtime
RUN echo "Building gorai-robot runtime" && \
    CGO_ENABLED=0 GOOS=linux go build \
        -ldflags="-s -w" \
        -o gorai-robot \
        ./cmd/gorai-robot

# =============================================================================
# Stage 2: Minimal runtime image
# =============================================================================
FROM docker.io/alpine:3.19

# Install podman client for building images (talks to host podman via socket)
RUN apk add --no-cache podman

# Copy Go binaries from builder
COPY --from=builder /build/gorai /usr/local/bin/gorai
COPY --from=builder /build/gorai-robot /usr/local/bin/gorai-robot

# Ensure binaries are executable
RUN chmod +x /usr/local/bin/gorai /usr/local/bin/gorai-robot

# Set working directory for mounted workspaces
WORKDIR /workspace

# Environment defaults
ENV LOG_LEVEL=info
# Tell podman client to use the mounted socket
ENV CONTAINER_HOST=unix:///run/podman/podman.sock

# Labels
LABEL org.opencontainers.image.title="Gorai"
LABEL org.opencontainers.image.description="Gorai robotics framework - CLI and runtime binaries"
LABEL org.opencontainers.image.source="https://github.com/gorai/gorai"
LABEL org.opencontainers.image.vendor="Gorai Project"

# Default entrypoint is the CLI
ENTRYPOINT ["/usr/local/bin/gorai"]
CMD ["help"]
